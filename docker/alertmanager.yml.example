global:
  smtp_smarthost: "smtp.alerts.example:587"
  smtp_from: "dispatch-alerts@example.com"
  smtp_auth_username: "dispatch-alerts@example.com"
  smtp_auth_password: "replace-me"
  smtp_require_tls: true

route:
  receiver: admin-email
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: admin-email
    email_configs:
      - to: "admin@example.com"
        send_resolved: true
      # Add one email_configs entry per administrator who should receive alerts.
