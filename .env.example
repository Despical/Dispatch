SPRING_PROFILES_ACTIVE=development
APP_PORT=8080
APP_BIND_HOST=127.0.0.1
APP_HOST_PORT=8082
DATABASE_URL=jdbc:mysql://localhost:3306/dispatch?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=dispatch
DATABASE_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Generate each value independently. Do not reuse keys.
JWT_SIGNING_KEY_BASE64=replace-with-32-or-more-random-bytes-as-base64
DATA_ENCRYPTION_KEY_BASE64=replace-with-exactly-32-random-bytes-as-base64
BOOTSTRAP_TOKEN=replace-with-a-long-single-use-random-token
BOOTSTRAP_TRUSTED_ADDRESS=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
PROMETHEUS_SCRAPE_TOKEN=replace-with-a-separate-random-monitoring-token

MAIL_STORAGE_PATH=./data/attachments
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MAIL_ALLOW_PRIVATE_HOSTS=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local development; use https://mail.despical.dev/oauth/google/callback on production.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/google/callback
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
